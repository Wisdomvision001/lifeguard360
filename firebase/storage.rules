rules_version = '2';

// ============================================================================
// Lifeguard360 — Storage Security Rules (Phase 11)
//
// First-aid educational videos are the only user-facing content. They are
// app-published, version-controlled with the guide content, and publicly
// readable. There is NO user-generated upload in the MVP (data minimisation),
// so all client writes are denied.
// ============================================================================

service firebase.storage {
  match /b/{bucket}/o {

    // Public educational videos, e.g. videos/burns/lesson-v1.mp4
    match /videos/{categoryId}/{fileName} {
      allow read: if true;
      allow write: if false; // published via console/admin tooling only
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
