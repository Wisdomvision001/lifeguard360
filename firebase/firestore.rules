rules_version = '2';

// ============================================================================
// Lifeguard360 — Firestore Security Rules (Phase 11)
//
// Security architecture (CIA triad, AD-19):
//   - Firestore rules are the ONLY enforcement layer; the client is never
//     trusted for authorization decisions.
//   - Least privilege: each principal (guest / owner) gets exactly the access
//     its role requires, nothing more.
//   - Data minimisation is modelled in what is even writable.
//
// Collections:
//   users/{uid}                    — owner read/update on a strict field set
//   users/{uid}/contacts/{id}      — owner-only CRUD
//   users/{uid}/activity/{id}      — owner-only create (append-only) + read
//   firstAidGuides/{category}      — public read; create/update only
//                                    for admins carrying the admin custom
//                                    claim, through the same content
//                                    validation as the published dataset
//   firstAidDrafts/{category}      — admin-only draft working copies
//                                    (never readable by the public); same
//                                    content validation as published
//   facilities/{id}                — public read; no client writes
//   config/{doc}                   — public read; no client writes
//
// NOTE: There are no responder/dispatch collections by design — Lifeguard360
// is an individual-user assistance platform, not a dispatch system.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------- helpers

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Server-side admin authorization (Stage 3): the SAME custom claim the
    // client guard reads, evaluated independently here as the real security
    // boundary. Strict boolean equality — a missing, false, "true", 1 or "1"
    // claim NEVER authorizes. Only operator-held Admin SDK tooling
    // (tools/setAdminClaim.ts) can set or clear the claim; nothing in this
    // database lets a client grant itself admin rights.
    function isAdmin() {
      return isSignedIn() && request.auth.token.get('admin', false) == true;
    }

    // UserPreferences is a closed, correctly-typed map mirroring the app's
    // UserPreferences model exactly: language (string), ttsEnabled (bool),
    // commsNoticeAcknowledged (bool). Unknown keys, missing keys and wrong
    // value types are rejected outright.
    function isValidPreferences(prefs) {
      return prefs is map
        && prefs.keys().hasAll(['language', 'ttsEnabled', 'commsNoticeAcknowledged'])
        && prefs.keys().hasOnly(['language', 'ttsEnabled', 'commsNoticeAcknowledged'])
        && prefs.language is string
        && prefs.language.size() >= 1
        && prefs.language.size() <= 12
        && prefs.ttsEnabled is bool
        && prefs.commsNoticeAcknowledged is bool;
    }

    // phone is nullable; when present it must be a Nigerian E.164 number —
    // the same constraint the contacts rules already enforce. Absence of the
    // key is tolerated (older shape), null means "unset".
    function hasValidProfilePhone(data) {
      return !('phone' in data)
        || data.phone == null
        || (data.phone is string && data.phone.matches('^\\+234[0-9]{10}$'));
    }

    // GeoCoordinates as the application writes it: exactly {latitude,
    // longitude}, both numbers, no extra keys. (Phase 5B shape.)
    function isValidCoordinates(coords) {
      return coords is map
        && coords.keys().hasAll(['latitude', 'longitude'])
        && coords.keys().hasOnly(['latitude', 'longitude'])
        && coords.latitude is number
        && coords.longitude is number;
    }

    // GuideStep exactly as the application publishes it (src/types GuideStep,
    // reconciled 2026-10): { title, text } are required; image / imageAlt /
    // warning are optional media and safety fields. The previous shape here
    // ({ number, title, text, flaggedPhrases }) did not exist anywhere in the
    // application and could never accept real content — this is a schema
    // reconciliation, not a relaxation: every field is strictly typed and
    // length-bounded, and unknown keys are still rejected outright.
    function isValidGuideStep(step) {
      return step is map
        && step.keys().hasAll(['title', 'text'])
        && step.keys().hasOnly(['title', 'text', 'image', 'imageAlt', 'warning'])
        && step.title is string
        && step.title.size() >= 1
        && step.title.size() <= 120
        && step.text is string
        && step.text.size() >= 1
        && step.text.size() <= 2000
        // image may be a public/images path or a Firebase Storage download
        // URL (both bounded; 512 fits real Storage download URLs).
        && (!('image' in step)
          || (step.image is string && step.image.size() <= 512))
        && (!('imageAlt' in step)
          || (step.imageAlt is string && step.imageAlt.size() <= 300))
        && (!('warning' in step)
          || (step.warning is string && step.warning.size() <= 500));
    }

    // First-aid guide content (FirstAidGuideVersion minus the review
    // envelope): the exact shape the bundled dataset publishes. Life-safety
    // content is validated the same way for admins as for any other write —
    // an admin claim never bypasses content validation.
    function isValidGuideContent(content) {
      return content is map
        && content.keys().hasAll(
          ['contentVersion', 'summary', 'steps', 'dos', 'donts', 'whenToSeekHelp', 'quickGuide', 'provenance'])
        && content.keys().hasOnly(
          ['contentVersion', 'summary', 'steps', 'dos', 'donts', 'whenToSeekHelp', 'quickGuide', 'provenance', 'variants', 'video', 'reviewedBy', 'reviewedAt'])
        && content.contentVersion is string
        && content.contentVersion.size() >= 1
        && content.contentVersion.size() <= 40
        && content.summary is string
        && content.summary.size() >= 1
        && content.summary.size() <= 2000
        && content.steps is list
        && content.steps.size() >= 1
        && content.dos is list
        && content.donts is list
        && content.whenToSeekHelp is list
        && content.quickGuide is map
        && content.provenance is list
        && content.provenance.size() <= 50
        && content.steps[0] is map
        && isValidGuideStep(content.steps[0]);
    }

    // The guide document body shared by BOTH the published guide
    // (firstAidGuides) and its admin-only draft twin (firstAidDrafts): the
    // draft and the published copy are validated identically, so a draft that
    // saves can always be published without shape changes. CEL has no list
    // concatenation operator, so the two full allowed-key sets (body + the
    // collection's timestamp field) are spelled out separately below.
    function publishedGuideKeys() {
      return ['id', 'label', 'summary', 'iconClass', 'image', 'content',
              'provenance', 'publishedAt'];
    }

    function draftGuideKeys() {
      return ['id', 'label', 'summary', 'iconClass', 'image', 'content',
              'provenance', 'updatedAt'];
    }

    function hasValidGuideBody(data, categoryId) {
      return data.keys().hasAll(['id', 'label', 'summary', 'content', 'provenance'])
        && data.id == categoryId
        && data.label is string
        && data.label.size() >= 1
        && data.label.size() <= 80
        && data.summary is string
        && data.summary.size() >= 1
        && data.summary.size() <= 2000
        && data.iconClass is string
        && data.iconClass.size() <= 80
        // image is optional: a public/images path or a Firebase Storage
        // download URL when present.
        && (!('image' in data)
          || (data.image is string && data.image.size() <= 512))
        && data.provenance is list
        && data.provenance.size() <= 50
        && isValidGuideContent(data.content);
    }

    // Activity detail shapes mirror the application's logActivity call sites
    // EXACTLY (src/services/activity/activityService.ts callers). Each type
    // accepts only its documented variant(s); unknown keys, missing keys and
    // wrong value types are rejected. The type check first is what makes the
    // per-type key accesses below safe (short-circuit on mismatched type).
    function isValidActivityDetail(type, detail) {
      return (type == 'contact_added'
          && detail.keys().hasAll(['relationship'])
          && detail.keys().hasOnly(['relationship'])
          && detail.relationship is string
          && detail.relationship in ['Parent', 'Sibling', 'Spouse', 'Friend', 'Guardian', 'Other'])
        || (type == 'contact_updated'
          && detail.keys().hasAll(['contactId'])
          && detail.keys().hasOnly(['contactId'])
          && detail.contactId is string)
        || (type == 'contact_deleted'
          && detail.keys().hasAll(['contactId'])
          && detail.keys().hasOnly(['contactId'])
          && detail.contactId is string)
        || (type == 'location_shared'
          && detail.via is string
          && ((detail.via == 'sms'
              && detail.keys().hasAll(['via', 'contactId', 'coordinates'])
              && detail.keys().hasOnly(['via', 'contactId', 'coordinates'])
              && detail.contactId is string
              && isValidCoordinates(detail.coordinates))
            || (detail.via == 'get-help'
              && detail.keys().hasAll(['via', 'coordinates'])
              && detail.keys().hasOnly(['via', 'coordinates'])
              && isValidCoordinates(detail.coordinates))))
        || (type == 'emergency_action'
          && detail.action is string
          && detail.contactId is string
          && ((detail.action == 'sms_prepared'
              && detail.keys().hasAll(['action', 'contactId', 'includedLocation'])
              && detail.keys().hasOnly(['action', 'contactId', 'includedLocation'])
              && detail.includedLocation is bool)
            || (detail.action == 'call_initiated'
              && detail.keys().hasAll(['action', 'contactId', 'observedState'])
              && detail.keys().hasOnly(['action', 'contactId', 'observedState'])
              && detail.observedState is string
              && detail.observedState in ['action-available', 'preparing',
                 'message-prepared', 'composer-opened', 'unavailable'])))
        || (type == 'offline_download'
          && detail.keys().hasAll(['version'])
          && detail.keys().hasOnly(['version'])
          && detail.version is string);
    }

    // ------------------------------------------------------------- users

    match /users/{uid} {
      // Profiles are readable by their owner; admins (admin custom claim) may
      // additionally READ profiles for user administration. Confidentiality:
      // contacts, phone and preferences are personal data — admin access is
      // READ only, writes stay strictly owner-controlled below.
      allow get, list: if isOwner(uid) || isAdmin();

      // Integrity: the client may set its own profile on creation and update
      // presentation fields, but never timestamps (server-set) and never
      // introduce unknown fields.
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(
          ['displayName', 'phone', 'preferences', 'createdAt', 'updatedAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1
        && request.resource.data.displayName.size() <= 80
        && isValidPreferences(request.resource.data.preferences)
        && hasValidProfilePhone(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(
          ['displayName', 'phone', 'preferences', 'createdAt', 'updatedAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1
        && request.resource.data.displayName.size() <= 80
        && isValidPreferences(request.resource.data.preferences)
        && hasValidProfilePhone(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;

      allow delete: if false; // MVP: accounts are not deletable from the client

      // ------------------------------------------------- contacts (subcollection)

      match /contacts/{contactId} {
        allow read: if isOwner(uid);

        // Confidentiality + integrity: contact records are strictly owned,
        // strictly validated, phone numbers must be E.164 Nigerian format.
        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly(
            ['fullName', 'relationship', 'phoneNumber', 'createdAt', 'updatedAt'])
          && request.resource.data.fullName is string
          && request.resource.data.fullName.size() >= 2
          && request.resource.data.fullName.size() <= 80
          && request.resource.data.relationship in
            ['Parent', 'Sibling', 'Spouse', 'Friend', 'Guardian', 'Other']
          && request.resource.data.phoneNumber is string
          && request.resource.data.phoneNumber.matches('^\\+234[0-9]{10}$')
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

        allow update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(
            ['fullName', 'relationship', 'phoneNumber', 'createdAt', 'updatedAt'])
          && request.resource.data.fullName is string
          && request.resource.data.fullName.size() >= 2
          && request.resource.data.fullName.size() <= 80
          && request.resource.data.relationship in
            ['Parent', 'Sibling', 'Spouse', 'Friend', 'Guardian', 'Other']
          && request.resource.data.phoneNumber is string
          && request.resource.data.phoneNumber.matches('^\\+234[0-9]{10}$')
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time;

        allow delete: if isOwner(uid);
      }

      // ------------------------------------------------- activity (subcollection)

      match /activity/{activityId} {
        // Append-only audit trail: owner can read and create, never update
        // or delete. Integrity over convenience. detail must match the
        // application's exact per-type payload shape (no free-form data).
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['type', 'detail', 'createdAt'])
          && request.resource.data.type in
            ['contact_added', 'contact_updated', 'contact_deleted',
             'location_shared', 'emergency_action', 'offline_download']
          && request.resource.data.detail is map
          && isValidActivityDetail(request.resource.data.type, request.resource.data.detail)
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    // ----------------------------------------------------- first aid content

    match /firstAidGuides/{categoryId} {
      // Availability: guides are public read so guests get life-saving
      // content without an account.
      allow get, list: if true;

      // Integrity: admins may publish and revise guide content, but ONLY
      // through the exact validated shape the application publishes — an
      // admin claim never bypasses content validation. publishedAt is
      // server-set on create and immutable afterwards.
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(publishedGuideKeys())
        && hasValidGuideBody(request.resource.data, categoryId)
        && request.resource.data.publishedAt == request.time;

      allow update: if isAdmin()
        && request.resource.data.keys().hasOnly(publishedGuideKeys())
        && request.resource.data.id == resource.data.id
        && hasValidGuideBody(request.resource.data, categoryId)
        && request.resource.data.publishedAt == resource.data.publishedAt;

      // Guides are version-controlled content; deletion would orphan the
      // published versions history. Withdraw content by publishing a new
      // version instead.
      allow delete: if false;

      match /versions/{versionId} {
        allow get, list: if true;
        allow write: if false; // immutable published versions — even for admins
      }
    }

    // ----------------------------------------------- first aid draft copies

    match /firstAidDrafts/{categoryId} {
      // Confidentiality: drafts are unfinished working copies. They are
      // readable ONLY by admins — the public never sees unpublished content.
      allow read: if isAdmin();

      // Integrity: identical content validation to the published guide
      // (hasValidGuideBody), plus a server-set updatedAt on every write. A
      // draft never carries publishedAt — publication state is which
      // collection the document lives in, never a client-set flag.
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(draftGuideKeys())
        && hasValidGuideBody(request.resource.data, categoryId)
        && request.resource.data.updatedAt == request.time;

      allow update: if isAdmin()
        && request.resource.data.keys().hasOnly(draftGuideKeys())
        && request.resource.data.id == resource.data.id
        && hasValidGuideBody(request.resource.data, categoryId)
        && request.resource.data.updatedAt == request.time;

      // Discarding a draft is an admin workflow action, not content deletion:
      // published guides are unaffected (they live in firstAidGuides, where
      // delete stays false).
      allow delete: if isAdmin();
    }

    // ------------------------------------------------------------- facilities

    match /facilities/{facilityId} {
      // Availability: verified facility data is public read.
      allow get, list: if true;

      // Integrity: facility records enter only through the verified
      // data-preparation pipeline (admin tooling), never from clients.
      allow write: if false;
    }

    // ----------------------------------------------------------------- config

    match /config/{docId} {
      allow get, list: if true;
      allow write: if false; // managed via console only
    }

    // ------------------------------------------------- default deny everything

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
