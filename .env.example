# Lifeguard360 environment variables — PUBLIC Firebase web config only.
# Copy to .env.local and fill with your Firebase project's web app config.
# NEVER put private keys (service accounts, admin SDK keys) in this file.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Google Maps Platform (public browser key, HTTP-referrer restricted; future phases)
VITE_MAPS_API_KEY=
