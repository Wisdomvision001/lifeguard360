{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,

    "strict": true
  },
  "include": ["vite.config.ts", "playwright.config.ts", "eslint.config.js", "prettier.config.mjs", "vitest.rules.config.ts", "firestore.rules.test.ts", "tools/**/*.ts"]
}
